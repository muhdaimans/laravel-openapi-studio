{
    "name": "muhdaimans/laravel-openapi-studio",
    "description": "A local-only visual editor for creating, editing and deleting OpenAPI 3 (.yaml/.json) files in a Laravel project.",
    "type": "library",
    "license": "MIT",
    "keywords": ["laravel", "openapi", "swagger", "api", "editor", "yaml"],
    "require": {
        "php": "^8.2",
        "illuminate/support": "^11.0|^12.0|^13.0",
        "illuminate/http": "^11.0|^12.0|^13.0",
        "illuminate/routing": "^11.0|^12.0|^13.0",
        "symfony/yaml": "^7.0|^8.0"
    },
    "require-dev": {
        "orchestra/testbench": "^9.0|^10.0|^11.0",
        "phpunit/phpunit": "^11.0|^12.0"
    },
    "autoload": {
        "psr-4": {
            "OpenApiStudio\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "OpenApiStudio\\Tests\\": "tests/"
        }
    },
    "extra": {
        "laravel": {
            "providers": [
                "OpenApiStudio\\OpenApiStudioServiceProvider"
            ]
        }
    },
    "scripts": {
        "test": "phpunit"
    },
    "minimum-stability": "stable",
    "prefer-stable": true
}
